# =============================================================================
# VidyaFlow Curriculum & AI Backend Configuration
# =============================================================================
APP_NAME="VidyaFlow Educational Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# -----------------------------------------------------------------------------
# Local Vector Database (ChromaDB - Zero Cost, Local Persistent Storage)
# -----------------------------------------------------------------------------
CHROMA_DB_DIR="./chroma_db"

# -----------------------------------------------------------------------------
# LLM Free Tier API Configurations
# -----------------------------------------------------------------------------
# 1. Google Gemini API (Get free key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_TIMEOUT_SECONDS=25

# 2. Groq Cloud Free Tier API (Optional fast fallback from: https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# -----------------------------------------------------------------------------
# Relational Database Configuration (SQLite default, PostgreSQL compatible)
# -----------------------------------------------------------------------------
DATABASE_URL="sqlite:///./vidyaflow.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/vidyaflow"

# -----------------------------------------------------------------------------
# CORS & Web Client Settings
# -----------------------------------------------------------------------------
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:5173"]
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
